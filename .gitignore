# Original game/media stay local.
local-media/
*.[bB][iI][nN]
*.[cC][uU][eE]
*.[iI][sS][oO]
*.[eE][xX][eE]
*.[dD][aA][tT]
*.[tT][rR][eE]
*.[wW][aA][vV]
*.[aA][vV][iI]
*.flac
*.mp3
*.ogg
*.mp4
*.mov
*.mkv

# Active engine checkout and generated app binaries stay separate.
/scummvm/
prototype/*.app/
prototype/*.patch
prototype/*.ini
prototype/saves/
*.o
*.a
*.dylib
*.so
*.dSYM/

# Keep research exports/catalogues and selected PNG evidence; omit run output.
*.log
analysis/ghidra-project/
analysis/**/*.bmp
*.gpr
*.rep/
*.gpr.lock
*.rep.lock

# Local environments, caches and temporary files.
.venv/
venv/
.pytest_cache/
__pycache__/
*.py[cod]
*.tmp
*.swp
*.swo
.DS_Store

# Fresh-analysis export of decompiled original code stays local.
/re/export/
/re/.venv/
